{
  "name": "vue-feature-toggles",
  "version": "0.1.20",
  "description": "Backend-agnostic feature flags for Vue 3 — boolean and multivariate flags, contextual rules, URL overrides, SSR hydration, DevTools and CLI.",
  "author": "macrulez <macrulezru@gmail.com> (https://macrulez.ru/en)",
  "license": "MIT",
  "homepage": "https://npm.vuecraft.ru/en/packages/vue-feature-toggles/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/macrulezru/vue-feature-toggles.git"
  },
  "bugs": {
    "url": "https://github.com/macrulezru/vue-feature-toggles/issues"
  },
  "keywords": [
    "vue",
    "vue3",
    "feature-flags",
    "feature-toggles",
    "ab-testing",
    "multivariate",
    "ssr",
    "devtools",
    "typescript"
  ],
  "type": "module",
  "main": "./dist/vue-feature-toggles.cjs",
  "module": "./dist/vue-feature-toggles.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/vue-feature-toggles.js",
      "require": "./dist/vue-feature-toggles.cjs"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs"
    },
    "./storybook": {
      "types": "./dist/storybook.d.ts",
      "import": "./dist/storybook.js",
      "require": "./dist/storybook.cjs"
    },
    "./adapters": {
      "types": "./dist/adapters.d.ts",
      "import": "./dist/adapters.js",
      "require": "./dist/adapters.cjs"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js",
      "require": "./dist/vite.cjs"
    },
    "./nuxt": "./nuxt/module.ts"
  },
  "bin": {
    "vue-feature-toggles": "./bin/cli.js"
  },
  "files": [
    "dist",
    "nuxt",
    "bin",
    "src/vite.ts",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "prepublishOnly": "npm run build",
    "dev": "vite serve demo --config demo/vite.config.ts",
    "demo": "vite serve demo --config demo/vite.config.ts",
    "build": "vite build",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "@nuxt/kit": ">=3.0.0",
    "@vue/devtools-api": ">=7.0.0",
    "vue": "^3.0.0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    },
    "@vue/devtools-api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@nuxt/kit": "^3.17.3",
    "@nuxt/schema": "^3.17.3",
    "@types/node": "^25.6.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/devtools-api": "^8.1.1",
    "@vue/test-utils": "^2.4.10",
    "happy-dom": "^20.9.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^4.1.6",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.8"
  }
}
